{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.11.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceId":104884,"sourceType":"datasetVersion","datasetId":54339}],"dockerImageVersionId":31193,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":true}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# Full HAM10000 training script — Custom CNN (matches Table II)\n# Run in Kaggle Notebook (assuming dataset is at /kaggle/input/ham10000)\n\nimport os\nimport shutil\nimport random\nimport numpy as np\nimport pandas as pd\nfrom PIL import Image\nfrom tqdm import tqdm\n\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader\nfrom torchvision import transforms\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.preprocessing import LabelEncoder\nfrom sklearn.metrics import confusion_matrix, classification_report\n\n# -------------------------\n# Config\n# -------------------------\nROOT_INPUT = \"/kaggle/input/skin-cancer-mnist-ham10000\"        # Kaggle input path\nMERGED_DIR = \"/kaggle/working/all_images\"   # merged images we created earlier\nMETA = os.path.join(ROOT_INPUT, \"HAM10000_metadata.csv\")\nBATCH_SIZE = 32\nIMG_SIZE = 224\nNUM_CLASSES = 7\nSEED = 42\nEPOCHS = 50                # exact as requested\nLR = 1e-4\nPATIENCE = 8               # early stopping patience\nDEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\nBEST_MODEL_PATH = \"best_custom_cnn.pt\"\n\nprint(\"Device:\", DEVICE)\n\n# -------------------------\n# Ensure merged folder exists (if not, merge parts)\n# -------------------------\nif not os.path.exists(MERGED_DIR):\n    os.makedirs(MERGED_DIR, exist_ok=True)\n    part1 = os.path.join(ROOT_INPUT, \"HAM10000_images_part_1\")\n    part2 = os.path.join(ROOT_INPUT, \"HAM10000_images_part_2\")\n    # copy files (if present)\n    for d in [part1, part2]:\n        if os.path.exists(d):\n            for f in os.listdir(d):\n                src = os.path.join(d, f)\n                dst = os.path.join(MERGED_DIR, f)\n                if not os.path.exists(dst):\n                    shutil.copy(src, dst)\n    print(\"Merged images into:\", MERGED_DIR)\nelse:\n    print(\"Merged images folder exists:\", MERGED_DIR)\n\n# -------------------------\n# Load metadata and add path\n# -------------------------\ndf = pd.read_csv(META)\ndf['path'] = df['image_id'].apply(lambda x: os.path.join(MERGED_DIR, f\"{x}.jpg\"))\n\n# Remove rows if image file missing (safety)\ndf = df[df['path'].apply(os.path.exists)].reset_index(drop=True)\nprint(\"Total samples after path check:\", len(df))\n\n# -------------------------\n# Encode labels\n# -------------------------\nle = LabelEncoder()\ndf['label'] = le.fit_transform(df['dx'])\nprint(\"Classes:\", le.classes_)\nNUM_CLASSES = df['label'].nunique()\n\n# -------------------------\n# Train/Val split (stratified)\n# -------------------------\ntrain_df, val_df = train_test_split(df, test_size=0.2, random_state=SEED, stratify=df['label'])\ntrain_df = train_df.reset_index(drop=True)\nval_df = val_df.reset_index(drop=True)\nprint(\"Train samples:\", len(train_df), \"Val samples:\", len(val_df))\n\n# -------------------------\n# Dataset\n# -------------------------\nclass HAMDataset(Dataset):\n    def __init__(self, df, transforms=None):\n        self.df = df\n        self.transforms = transforms\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        row = self.df.iloc[idx]\n        img = Image.open(row['path']).convert(\"RGB\")\n        if self.transforms:\n            img = self.transforms(img)\n        label = int(row['label'])\n        return img, label\n\n# -------------------------\n# Transforms\n# -------------------------\ntrain_transforms = transforms.Compose([\n    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n    transforms.RandomRotation(20),\n    transforms.RandomHorizontalFlip(),\n    transforms.RandomVerticalFlip(p=0.1),\n    transforms.ColorJitter(brightness=0.15, contrast=0.15, saturation=0.05, hue=0.02),\n    transforms.ToTensor()\n])\n\nval_transforms = transforms.Compose([\n    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n    transforms.ToTensor()\n])\n\n# -------------------------\n# Dataloaders\n# -------------------------\ntrain_ds = HAMDataset(train_df, transforms=train_transforms)\nval_ds = HAMDataset(val_df, transforms=val_transforms)\n\ntrain_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True, num_workers=2, pin_memory=True)\nval_loader = DataLoader(val_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=2, pin_memory=True)\n\n# -------------------------\n# Build Custom CNN exactly like Table II\n# (Conv2D 32 -> MaxPool -> Conv2D 64 -> MaxPool -> Conv2D 128 -> MaxPool -> Flatten -> Dense256 -> Dropout0.5 -> Dense7)\n# -------------------------\nclass CustomCNN_TableII(nn.Module):\n    def __init__(self, num_classes=7):\n        super().__init__()\n        # Conv block 1\n        self.conv1 = nn.Conv2d(3, 32, kernel_size=3, padding=1)   # output 224x224x32\n        self.relu = nn.ReLU(inplace=True)\n        self.pool = nn.MaxPool2d(kernel_size=2, stride=2)         # halves spatial dims\n\n        # Conv block 2\n        self.conv2 = nn.Conv2d(32, 64, kernel_size=3, padding=1)  # output 112x112x64 after pool\n\n        # Conv block 3\n        self.conv3 = nn.Conv2d(64, 128, kernel_size=3, padding=1) # output 56x56x128 then pool -> 28x28x128\n\n        # After three pools: spatial dims = 28 x 28, channels = 128 -> flatten size 28*28*128 = 100352\n        self.flatten_in_features = 28 * 28 * 128\n\n        # Dense layers\n        self.fc1 = nn.Linear(self.flatten_in_features, 256)       # matches Table II params\n        self.dropout = nn.Dropout(0.5)\n        self.fc2 = nn.Linear(256, num_classes)\n\n    def forward(self, x):\n        x = self.relu(self.conv1(x))\n        x = self.pool(x)\n\n        x = self.relu(self.conv2(x))\n        x = self.pool(x)\n\n        x = self.relu(self.conv3(x))\n        x = self.pool(x)\n\n        x = x.view(x.size(0), -1)      # flatten\n        x = self.relu(self.fc1(x))\n        x = self.dropout(x)\n        x = self.fc2(x)\n        return x\n\nmodel = CustomCNN_TableII(num_classes=NUM_CLASSES).to(DEVICE)\n\n# Print model summary (parameter counts)\ndef count_parameters(model):\n    return sum(p.numel() for p in model.parameters() if p.requires_grad)\n\nprint(\"Model parameters:\", count_parameters(model))\n# Expect around: conv params + dense params (dense ~25.69M as in paper)\n\n# -------------------------\n# Loss, optimizer, scheduler\n# -------------------------\ncriterion = nn.CrossEntropyLoss()\noptimizer = torch.optim.Adam(model.parameters(), lr=LR)\nscheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='min', factor=0.5, patience=4, verbose=True)\n\n# -------------------------\n# Training loop with early stopping (patience)\n# -------------------------\nbest_val_acc = 0.0\nbest_epoch = -1\nno_improve_epochs = 0\n\nfor epoch in range(1, EPOCHS + 1):    # exact 50 epochs max\n    model.train()\n    running_loss = 0.0\n    running_corrects = 0\n    total = 0\n\n    for images, labels in tqdm(train_loader, desc=f\"Train Epoch {epoch}/{EPOCHS}\", leave=False):\n        images = images.to(DEVICE)\n        labels = labels.to(DEVICE)\n\n        optimizer.zero_grad()\n        outputs = model(images)\n        loss = criterion(outputs, labels)\n        loss.backward()\n        optimizer.step()\n\n        running_loss += loss.item() * images.size(0)\n        _, preds = torch.max(outputs, 1)\n        running_corrects += torch.sum(preds == labels).item()\n        total += labels.size(0)\n\n    epoch_loss = running_loss / total\n    epoch_acc = running_corrects / total\n\n    # Validation\n    model.eval()\n    val_running_loss = 0.0\n    val_running_corrects = 0\n    val_total = 0\n    all_preds = []\n    all_labels = []\n\n    with torch.no_grad():\n        for images, labels in tqdm(val_loader, desc=f\"Val Epoch {epoch}/{EPOCHS}\", leave=False):\n            images = images.to(DEVICE)\n            labels = labels.to(DEVICE)\n\n            outputs = model(images)\n            loss = criterion(outputs, labels)\n\n            val_running_loss += loss.item() * images.size(0)\n            _, preds = torch.max(outputs, 1)\n            val_running_corrects += torch.sum(preds == labels).item()\n            val_total += labels.size(0)\n\n            all_preds.extend(preds.cpu().numpy().tolist())\n            all_labels.extend(labels.cpu().numpy().tolist())\n\n    val_loss = val_running_loss / val_total\n    val_acc = val_running_corrects / val_total\n\n    print(f\"Epoch {epoch:02d} | Train Loss: {epoch_loss:.4f} Acc: {epoch_acc:.4f} | Val Loss: {val_loss:.4f} Acc: {val_acc:.4f}\")\n\n    # Scheduler step (on validation loss)\n    scheduler.step(val_loss)\n\n    # Save best model by val accuracy\n    if val_acc > best_val_acc:\n        best_val_acc = val_acc\n        best_epoch = epoch\n        no_improve_epochs = 0\n        torch.save(model.state_dict(), BEST_MODEL_PATH)\n        print(f\"  -> New best model saved (val_acc: {best_val_acc:.4f}) to {BEST_MODEL_PATH}\")\n    else:\n        no_improve_epochs += 1\n\n    # Early stopping\n    if no_improve_epochs >= PATIENCE:\n        print(f\"Early stopping triggered (no_improve_epochs={no_improve_epochs} >= {PATIENCE}).\")\n        break\n\nprint(f\"Training finished. Best val_acc: {best_val_acc:.4f} at epoch {best_epoch}\")\n\n# -------------------------\n# Load best model and evaluate on validation set (detailed)\n# -------------------------\nmodel.load_state_dict(torch.load(BEST_MODEL_PATH))\nmodel.eval()\n\nall_preds = []\nall_labels = []\n\nwith torch.no_grad():\n    for images, labels in val_loader:\n        images = images.to(DEVICE)\n        outputs = model(images)\n        _, preds = torch.max(outputs, 1)\n        all_preds.extend(preds.cpu().numpy().tolist())\n        all_labels.extend(labels.numpy().tolist())\n\n# Confusion matrix and classification report\ncm = confusion_matrix(all_labels, all_preds)\ncr = classification_report(all_labels, all_preds, target_names=list(le.classes_), digits=4)\n\nprint(\"Confusion Matrix:\\n\", cm)\nprint(\"\\nClassification Report:\\n\", cr)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-06T06:34:52.684339Z","iopub.execute_input":"2025-12-06T06:34:52.684665Z","iopub.status.idle":"2025-12-06T07:30:05.061487Z","shell.execute_reply.started":"2025-12-06T06:34:52.684636Z","shell.execute_reply":"2025-12-06T07:30:05.060635Z"}},"outputs":[{"name":"stdout","text":"Device: cuda\nMerged images into: /kaggle/working/all_images\nTotal samples after path check: 10015\nClasses: ['akiec' 'bcc' 'bkl' 'df' 'mel' 'nv' 'vasc']\nTrain samples: 8012 Val samples: 2003\n","output_type":"stream"},{"name":"stderr","text":"/usr/local/lib/python3.11/dist-packages/torch/optim/lr_scheduler.py:62: UserWarning: The verbose parameter is deprecated. Please use get_last_lr() to access the learning rate.\n  warnings.warn(\n","output_type":"stream"},{"name":"stdout","text":"Model parameters: 25785415\n","output_type":"stream"},{"name":"stderr","text":"                                                                   \r","output_type":"stream"},{"name":"stdout","text":"Epoch 01 | Train Loss: 1.0597 Acc: 0.6670 | Val Loss: 0.9200 Acc: 0.6695\n  -> New best model saved (val_acc: 0.6695) to best_custom_cnn.pt\n","output_type":"stream"},{"name":"stderr","text":"                                                                   \r","output_type":"stream"},{"name":"stdout","text":"Epoch 02 | Train Loss: 0.9269 Acc: 0.6734 | Val Loss: 0.8528 Acc: 0.6785\n  -> New best model saved (val